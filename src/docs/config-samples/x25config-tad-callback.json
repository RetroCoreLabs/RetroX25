    "Modulo": 8
  },

  "Routing": {
    "Enabled": true,
    "SerialInterfaces": [],
    "XotInterfaces": [
      {
        "Name": "XOT_Server0",
        "Enabled": true,
        "Mode": "Server",
        "LocalPort": 1998,
        "RemoteMachineId": "23430001",
        "TcpKeepalive": true,
        "KeepAliveIntervalSeconds": 30,
        "ProtocolMode": "X25Only",
        "Description": "Listens for XOT calls on TCP 1998, the port a Cisco router uses (R1: x25 route ^2343 xot <this PC>). Do not run the switch on the same PC at the same time: it listens on 1998 too."
      }
    ],
    "TcpLapbInterfaces": [],
    "RoutingTable": [
      {
        "Name": "LocalTAD",
        "X121AddressPattern": "23430200",
