{
  "SerialPort": "NONE",
  "BaudRate": 19200,
  "HistoryCapacity": 500,

  "Lapb": {
    "IsDCE": true,
    "T1Timeout": "00:00:03",
    "T2Timeout": "00:00:00.200",
    "T3Timeout": "00:00:00",
    "MaxRetries": 5,
    "WindowSize": 7,
    "Modulo": 8
  },

  "X25": {
    "LocalMachineId": "23430200",
    "T20Timeout": "00:00:30",
    "T21Timeout": "00:03:00",
    "T22Timeout": "00:00:30",
    "T23Timeout": "00:03:00",
    "MaxRetries": 3,
    "WindowSize": 2,
