<!--
  X.25 "telecom" palette (the default).

  A dark slate background with a cyan/blue accent and an amber secondary — evoking a
  telecom / network-operations console. This ResourceDictionary defines the full set of
  SEMANTIC brush keys the app binds to. The RetroFS palette (RetroFsPalette.axaml) defines
  the SAME key set with different colours, so ThemeManager can swap the whole dictionary at
  runtime and every {DynamicResource ...} in the UI restyles live.

  IMPORTANT: keep the key set here identical to RetroFsPalette.axaml. Adding a key to one
  palette but not the other will leave that brush unresolved when the other theme is active.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces / chrome -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1420" />
  <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#0A0F18" />
  <SolidColorBrush x:Key="AppBackgroundLightBrush" Color="#182234" />

  <!-- Borders -->
  <SolidColorBrush x:Key="AppBorderBrush" Color="#2A3648" />
  <SolidColorBrush x:Key="AppBorderActiveBrush" Color="#29B6F6" />

  <!-- Accent (primary) — cyan/blue -->
  <SolidColorBrush x:Key="AppAccentBrush" Color="#29B6F6" />
  <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#4FC3F7" />
  <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#0288D1" />

  <!-- Secondary — amber -->
  <SolidColorBrush x:Key="AppSecondaryBrush" Color="#FFB300" />

  <!-- Text -->
  <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#E8F0F8" />
  <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#9FB2C8" />

  <!-- Status -->
  <SolidColorBrush x:Key="AppSuccessBrush" Color="#43A047" />
  <SolidColorBrush x:Key="AppWarningBrush" Color="#FB8C00" />
  <SolidColorBrush x:Key="AppErrorBrush" Color="#E53935" />
  <SolidColorBrush x:Key="AppInfoBrush" Color="#29B6F6" />

  <!-- Network-map surface -->
  <SolidColorBrush x:Key="MapCanvasBrush" Color="#0B111B" />

  <!-- Network-map node state colours -->
  <SolidColorBrush x:Key="NodeReachableBrush" Color="#2E7D32" />
  <SolidColorBrush x:Key="NodeDegradedBrush" Color="#EF6C00" />
  <SolidColorBrush x:Key="NodeDownBrush" Color="#C62828" />
  <SolidColorBrush x:Key="NodeUnknownBrush" Color="#607080" />

  <!-- Network-map link (trunk) colours -->
  <SolidColorBrush x:Key="LinkUpBrush" Color="#43A047" />
  <SolidColorBrush x:Key="LinkDownBrush" Color="#B03A2E" />

  <!-- Node decoration -->
  <SolidColorBrush x:Key="NodeBorderBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="NodeTextBrush" Color="#FFFFFF" />

</ResourceDictionary>
