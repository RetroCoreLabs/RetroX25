    ],
    "TcpLapbInterfaces": [],
    "RoutingTable": [
      {
        "Name": "AltosChat",
        "X121AddressPattern": "26245890040004",
        "Type": "Local",
        "Destination": "CHAT",
        "Priority": 200,
        "Enabled": true,
        "Description": "Lets calls to the chat in; the chat takes them by its address (Chat.Address)"
      }
    ],
    "KnownHosts": []
  },

  "Timers": {
    "CentralTimerManagement": true
  },

  "Logging": {
