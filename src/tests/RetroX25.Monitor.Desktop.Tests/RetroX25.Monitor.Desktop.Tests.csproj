<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RetroX25.Monitor.Desktop.Tests</AssemblyName>
    <RootNamespace>RetroX25.Monitor.Desktop.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The window/view-models bind with compiled bindings; keep parity with the app project. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Headless Avalonia with real Skia rendering, so we can capture pixels and validate the UI. -->
    <PackageReference Include="Avalonia.Headless.NUnit" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroX25.Monitor.Desktop\RetroX25.Monitor.Desktop.csproj" />
  </ItemGroup>

</Project>
