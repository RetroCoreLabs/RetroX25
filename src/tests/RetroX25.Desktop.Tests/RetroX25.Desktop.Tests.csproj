<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RetroX25.Desktop.Tests</AssemblyName>
    <RootNamespace>RetroX25.Desktop.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The windows bind with compiled bindings; keep parity with the app project or the tests
         would resolve bindings a different way from the shipping app and prove nothing. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Headless Avalonia with real Skia rendering: a missing avares:// resource or an unresolvable
         DynamicResource only shows up when something actually renders. -->
    <PackageReference Include="Avalonia.Headless.NUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="RetroIO.Protocols.X25.Client" />
    <!-- The monitor client reads x25emu's per-port counters in the cross-environment tests. -->
    <PackageReference Include="RetroIO.Protocols.X25.Monitor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroX25.Desktop\RetroX25.Desktop.csproj" />
    <!-- The burst tests start these two command-line tools as real processes. They are built with the tests;
         the tests only run their programs, they never load them as libraries. -->
    <ProjectReference Include="..\..\RetroX25.Traffic\RetroX25.Traffic.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\RetroX25.Echo\RetroX25.Echo.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cross-environment helpers (the WSL process starter, the checker and the XOT wire tap) are shared with
         RetroX25.Tests by link: the tests where x25emu dials US must run in this project, because the Windows
         firewall decides inbound connections program by program. -->
    <Compile Include="..\RetroX25.Tests\Interop\X25emuEnvironment.cs" Link="Interop\X25emuEnvironment.cs" />
    <Compile Include="..\RetroX25.Tests\Interop\XotWireTap.cs" Link="Interop\XotWireTap.cs" />
    <Compile Include="..\RetroX25.Tests\Interop\X25emuEchoPool.cs" Link="Interop\X25emuEchoPool.cs" />
    <Compile Include="..\RetroX25.Tests\Interop\X25emuMonitor.cs" Link="Interop\X25emuMonitor.cs" />
  </ItemGroup>

</Project>
