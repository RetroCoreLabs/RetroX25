<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroX25.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="RetroX25.Desktop.Views.StatusWindow"
        x:DataType="vm:StatusWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="Status Information"
        Width="1000" Height="700"
        MinWidth="700" MinHeight="500">

    <!--
        The Status window is the only place in the application that shows counters.
        One table: a row for each counter, a column for the engine's total and then one for each link
        and each transport interface. The table itself is built in code (StatusWindow.axaml.cs)
        because the number of columns depends on the links and interfaces that exist.
    -->
    <DockPanel LastChildFill="True">

        <!-- Button bar (docked to bottom) -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Name="ResetButton"
                            Command="{Binding ResetStatisticsCommand}"
                            Content="Reset Statistics"
                            Width="140"/>
                    <Button Name="RefreshButton"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh Now"
                            Width="120"/>
                </StackPanel>
                <TextBlock Name="ActionText"
                           Text="{Binding ActionText}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Header (docked to top) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Spacing="2">
                <TextBlock Text="Statistics (auto-refreshes every second)"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock Name="HeaderText" Text="{Binding HeaderText}" FontSize="11"/>
            </StackPanel>
        </Border>

        <!--
            The tables are put into these panels by the code behind: the counters, then the accounts of the
            built-in switch (a column for each account; empty, and hidden, when there are none). The accounts
            are the bill, so Reset Statistics does not reset them.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="16">
                <Border Name="TableHost"/>
                <Border Name="AccountsHost"/>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
