<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroX25.Desktop.ViewModels"
             x:Class="RetroX25.Desktop.Views.TcpLapbInterfacesTab"
             x:DataType="vm:TcpLapbInterfacesTabViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="TCP LAPB Interfaces - LAPB (the X.25 link layer) carried over a TCP connection"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Main content area -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- List of TCP-LAPB interfaces -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,12,0">
                <ListBox Name="TcpLapbList"
                         ItemsSource="{Binding TcpLapbInterfaces}"
                         SelectedItem="{Binding SelectedInterface}"
                         DisplayMemberBinding="{Binding DisplayText}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="FontFamily" Value="Consolas,Courier New"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Spacing="8">
                <Button Name="AddButton"
                        Command="{Binding AddInterfaceCommand}"
                        Content="Add"
                        Width="100"
                        HorizontalContentAlignment="Center"/>

                <Button Name="EditButton"
                        Command="{Binding EditInterfaceCommand}"
                        Content="Edit"
                        Width="100"
                        HorizontalContentAlignment="Center"/>

                <Button Name="DeleteButton"
                        Command="{Binding DeleteInterfaceCommand}"
                        Content="Delete"
                        Width="100"
                        HorizontalContentAlignment="Center"/>

                <Separator Height="1" Margin="0,8"/>

                <Button Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Width="100"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                Margin="0,12,0,0">
            <TextBlock Name="TcpLapbStatus"
                       Text="{Binding StatusText}"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
