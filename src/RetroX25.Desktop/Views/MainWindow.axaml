<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroX25.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RetroX25.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Hotkeys, following the Windows habits (F1 = Help, Alt+F4 = exit by the system). The menu items show the same keys as text only; these bindings do the work. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding ShowStatusWindowCommand}" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding ShowPacketWindowCommand}" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding ShowLogWindowCommand}" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding ShowRoutesWindowCommand}" />
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding ShowPADClientWindowCommand}" />
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding ShowTADServerWindowCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ShowLinkStatusWindowCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowConfigurationWindowCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Delete" Command="{Binding ClearPacketHistoryCommand}" />
    </Window.KeyBindings>

    <!-- Main layout with DockPanel -->
    <DockPanel LastChildFill="True">

        <!-- Menu Bar (docked to top) -->
        <Menu DockPanel.Dock="Top" Margin="0">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Alt+F4" />
            </MenuItem>

            <!-- Tools Menu -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Configuration..." Command="{Binding ShowConfigurationWindowCommand}" InputGesture="Ctrl+OemComma" />
                <Separator />
                <MenuItem Header="_Clear Packet History" Command="{Binding ClearPacketHistoryCommand}" InputGesture="Ctrl+Shift+Delete" />
            </MenuItem>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="_Reset Statistics" Command="{Binding ResetStatisticsCommand}" />
            </MenuItem>

            <!-- Windows Menu -->
            <MenuItem Header="_Windows">
                <MenuItem Header="_Status Information" Command="{Binding ShowStatusWindowCommand}" InputGesture="Ctrl+D1" />
                <MenuItem Header="_Packet Window" Command="{Binding ShowPacketWindowCommand}" InputGesture="Ctrl+D2" />
                <MenuItem Header="_Log Window" Command="{Binding ShowLogWindowCommand}" InputGesture="Ctrl+D3" />
                <MenuItem Header="Lin_k Status" Command="{Binding ShowLinkStatusWindowCommand}" InputGesture="Ctrl+L" />
                <MenuItem Header="_Routes..." Command="{Binding ShowRoutesWindowCommand}" InputGesture="Ctrl+D4" />
                <Separator />
                <MenuItem Header="PAD _Client Test" Command="{Binding ShowPADClientWindowCommand}" InputGesture="Ctrl+D5" />
                <MenuItem Header="_TAD Server Monitor" Command="{Binding ShowTADServerWindowCommand}" InputGesture="Ctrl+D6" />
                <MenuItem Header="_Simulate Receive..." Command="{Binding ShowSimulateReceiveWindowCommand}" />
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_Help" Command="{Binding ShowHelpCommand}" InputGesture="F1" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Status Bar (docked to bottom): one line, uptime and the plain answer to "is it up?". -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock FontSize="11" VerticalAlignment="Center">
                <Run Text="Uptime: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Run Text="{Binding RuntimeUptime}" FontWeight="SemiBold"/>
                <Run Text=" | "/>
                <Run Text="{Binding LinkSummary}" Foreground="{Binding LinkSummaryBrush}" FontWeight="SemiBold"/>
            </TextBlock>
        </Border>

        <!-- Main Content Area - Compact Status Display -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel Spacing="12">

                <!-- Host Information Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Host Information" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11">
                            <Run Text="Machine ID: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Run Text="{Binding LocalMachineId}" FontWeight="SemiBold"/>
                            <Run Text=" | DTE Address: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Run Text="{Binding LocalDteAddress}" FontWeight="SemiBold"/>
                            <Run Text=" | Gateway: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Run Text="{Binding DefaultGateway}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding SwitchStatus}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Interfaces Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Interfaces" FontSize="14" FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding Interfaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,8,0,8"
                                            Margin="0,4,0,0">
                                        <StackPanel Spacing="4">
                                            <!-- One short line: name, where it goes, up or down, data link state, far end -->
                                            <TextBlock FontSize="11">
                                                <Run Text="[" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                <Run Text="{Binding Enabled, Converter={StaticResource BoolToCheckConverter}}" FontWeight="Bold"/>
                                                <Run Text="] " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Details}"/>
                                                <Run Text=" ["/>
                                                <Run Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                                <Run Text="]"/>
                                                <Run Text="{Binding LapbPart}"/>
                                                <Run Text=" → Machine "/>
                                                <Run Text="{Binding RemoteMachineId}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No interfaces configured"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   IsVisible="{Binding Interfaces.Count, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                    </StackPanel>
                </Border>

                <!-- Trunk links: the real state of every XOT peer and every HDLC trunk (connected or LAPB link up, since when, how many failed connects and why, frames and retransmits). -->
                <Border Name="XotLinksSection"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        IsVisible="{Binding HasXotSection}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Trunk links" FontSize="14" FontWeight="SemiBold"/>

                        <!-- The built-in switch's own plumbing as one quiet line; red with the reason only when it fails. -->
                        <TextBlock Name="BuiltInSwitchLine"
                                   Text="{Binding BuiltInLine}"
                                   Foreground="{Binding BuiltInBrush}"
                                   FontSize="11"
                                   IsVisible="{Binding HasBuiltInLine}"/>

                        <ItemsControl Name="XotPeerList" ItemsSource="{Binding XotPeers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:XotPeerLineViewModel">
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,8,0,8"
                                            Margin="0,4,0,0">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="11">
                                                <Run Text="{Binding HeadStart}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding State}" FontWeight="Bold" Foreground="{Binding StateBrush}"/>
                                                <Run Text="]"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Behaviour}" FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Telnet PAD: off, listening (address, port, sessions) or failed (with the reason, in red). -->
                <Border Name="TelnetPadSection"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <TextBlock Name="TelnetPadLine"
                               Text="{Binding TelnetPadLine}"
                               Foreground="{Binding TelnetPadBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
