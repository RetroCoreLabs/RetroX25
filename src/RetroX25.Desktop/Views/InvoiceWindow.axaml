<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroX25.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="760"
        x:Class="RetroX25.Desktop.Views.InvoiceWindow"
        x:DataType="vm:InvoiceWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="Bill"
        Width="820" Height="760"
        MinWidth="700" MinHeight="400">

    <!--
        An account's bill for one month, worked out from the call record file and the price list by RetroIO's
        billing code (the same as "show x25 invoice" on the switch console). The bill is shown as it would be
        printed: a sheet of paper, a fixed-width typewriter font, 78 columns. The paper and ink colours are the
        paper's own and stay the same in a dark theme.
    -->
    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" >
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Call records" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="RecordFileBox" Text="{Binding RecordFile}" Margin="0,0,8,4"/>
                <Button Grid.Row="0" Grid.Column="2" Name="ReadButton" Content="Read accounts" Command="{Binding LoadAccountsCommand}" Margin="0,0,0,4" Width="130"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Price list" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TariffFileBox" Text="{Binding TariffFile}" Margin="0,0,8,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Account" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,8,4">
                    <ComboBox Name="AccountBox" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" MinWidth="200"/>
                    <TextBlock Text="Month (yyyy-mm)" VerticalAlignment="Center"/>
                    <TextBox Name="MonthBox" Text="{Binding Month}" Width="90"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="2" Name="BillButton" Content="Make the bill" Command="{Binding MakeBillCommand}" Margin="0,0,0,4" Width="130"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Name="ErrorLine" Text="{Binding ErrorText}"
                           Foreground="#C00000" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#8A8A8A">
            <Border Background="#FBF8EE" BorderBrush="#B8B2A0" BorderThickness="1"
                    Margin="24" Padding="28,32" HorizontalAlignment="Center" VerticalAlignment="Top"
                    BoxShadow="2 3 8 0 #60000000">
                <SelectableTextBlock Name="BillSheet"
                                     Text="{Binding BillText}"
                                     FontFamily="Courier New, Consolas, DejaVu Sans Mono, monospace"
                                     FontSize="12.5"
                                     Foreground="#1A1A40"
                                     MinWidth="560" MinHeight="300"/>
            </Border>
        </ScrollViewer>

    </DockPanel>

</Window>
