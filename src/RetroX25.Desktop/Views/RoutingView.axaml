<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroX25.Desktop.ViewModels"
             x:Class="RetroX25.Desktop.Views.RoutingView"
             x:DataType="vm:RoutingViewModel">

    <!-- The DataGrid renders nothing without its style. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <DockPanel LastChildFill="True" Margin="12">

        <!-- Own network card -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <TextBlock Text="Own network" FontSize="15" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="Auto,200,24,Auto,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Network (DNIC):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Name="OwnDnicsBox" Text="{Binding OwnDnicsText}" Watermark="for example 2422"
                             ToolTip.Tip="This node's network: 4 digits, or 5 with the digit after the DNIC. Several are separated by commas; the first one completes local numbers."/>
                    <TextBlock Grid.Column="3" Text="International prefix:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="4" Name="PrefixBox" Text="{Binding InternationalPrefix}" Watermark="none"
                             ToolTip.Tip="The digits dialled before an international number (X.121 7.8), for example 0. Leave empty when the network uses none."/>
                </Grid>
                <TextBlock Text="{Binding OwnNetworkText}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="{Binding OwnNetworkError}" TextWrapping="Wrap" Foreground="#F44336"
                           IsVisible="{Binding OwnNetworkError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="Auto,80,8,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="Max calls (whole switch):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Name="MaxCallsBox" Text="{Binding MaxCallsText}" Watermark="0"
                             IsEnabled="{Binding HasSwitchFile}"
                             ToolTip.Tip="The most calls the built-in switch carries at once. 0 = no limit. When it is reached the next call is cleared with Network congestion (cause 5). A call through the switch counts once."/>
                    <TextBlock Grid.Column="3" Text="0 = no limit" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Grid>
                <TextBlock Text="{Binding SwitchSettingsText}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="{Binding MaxCallsError}" TextWrapping="Wrap" Foreground="#F44336"
                           IsVisible="{Binding MaxCallsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- Lines and their channel counts -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <TextBlock Text="Lines" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="How many calls each line can carry at once (its logical channels, X.25 3.1). Leave the field empty for the default: every channel up to 4095. An XOT line also holds one TCP connection per channel."/>
                <DataGrid Name="LineGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Line" Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Channels" Binding="{Binding ChannelsText}" Width="130" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Set channels" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:LineRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                                        <TextBox Text="{Binding ChannelCountText}" Width="80" Watermark="default"
                                                 IsEnabled="{Binding IsEditable}" ToolTip.Tip="{Binding Hint}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="#F44336" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Save bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SaveTargetText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Unsaved changes" Foreground="#FFA726" VerticalAlignment="Center"
                               IsVisible="{Binding HasUnsavedChanges}"/>
                    <Button Content="Undo changes" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Read the routes from the configuration again and drop the changes made here."/>
                    <Button Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" Classes="accent" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Test an address -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Test an address" FontSize="15" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,8,220,8,Auto">
                    <TextBox Grid.Column="0" Name="TestNumberBox" Text="{Binding TestNumber}" Watermark="a called number, for example 024020001730"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ArrivalPorts}" SelectedItem="{Binding TestArrivalPort}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="The line the call comes in on. A route back out of that line is never used."/>
                    <Button Grid.Column="4" Name="TestButton" Content="Where does it go?" Command="{Binding TestAddressCommand}" IsDefault="True"/>
                </Grid>
                <SelectableTextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontFamily="Consolas,Courier New" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Route list -->
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Routes, in the order they are tried" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="The most exact route wins: a number, a pattern, the longest prefix, a network, a country, and the default gateway last. A route back out of the line a call came in on is skipped; a route that is off is skipped."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                    <Button Name="AddButton" Content="Add route..." Command="{Binding AddRouteCommand}"/>
                    <Button Content="Edit..." Command="{Binding EditRouteCommand}"/>
                    <Button Content="Delete" Command="{Binding DeleteRouteCommand}"/>
                    <Button Content="Update hit counts" Command="{Binding RefreshHitsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Name="RouteGrid"
                      ItemsSource="{Binding Routes}"
                      SelectedItem="{Binding SelectedRoute}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      MinHeight="160">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40"/>
                    <DataGridTemplateColumn Header="Kind" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:RouteRow">
                                <Border Background="{Binding KindBrush}" CornerRadius="9" Padding="8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Kind}" Foreground="{Binding KindTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130"/>
                    <DataGridTextColumn Header="Calls to" Binding="{Binding Match}" Width="2*"/>
                    <DataGridTextColumn Header="Go to (backups in order)" Binding="{Binding Target}" Width="2*"/>
                    <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="60"/>
                    <DataGridTemplateColumn Header="On" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:RouteRow">
                                <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="" OffContent=""
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
