<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroX25.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="RetroX25.Desktop.Views.XMSGServerWindow"
        x:DataType="vm:XMSGServerWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="Local XMSG Server - COSMOS File Services"
        Width="1200" Height="700"
        MinWidth="1000" MinHeight="600">

    <Design.DataContext>
        <vm:XMSGServerWindowViewModel/>
    </Design.DataContext>

    <!-- Main layout with DockPanel -->
    <DockPanel LastChildFill="True">

        <!-- Status Bar (docked to bottom) -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ServiceStatsText}"
                           FontSize="11"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ConnectionStatsText}"
                           FontSize="11"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Button Bar (docked to bottom, above status) -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Width="80"/>
                <Button Command="{Binding ViewServicesCommand}"
                        Content="View Services"
                        Width="120"/>
                <Button Command="{Binding DisconnectSessionCommand}"
                        Content="Disconnect Selected"
                        Width="150"
                        IsEnabled="{Binding CanDisconnect}"/>
                <Button Command="{Binding ClearAllSessionsCommand}"
                        Content="Clear All Sessions"
                        Width="150"/>
            </StackPanel>
        </Border>

        <!-- Help Text (docked to bottom, above buttons) -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="12,4">
            <StackPanel Spacing="2">
                <TextBlock Text="LocalXMSG Protocol handles XMSG connections for COSMOS File Services"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="Select a session from the list to view detailed information"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </Border>

        <!-- Header (docked to top) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="Built-in LocalXMSG Protocol Server - COSMOS File Services"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Main Content Area - Two columns -->
        <Grid ColumnDefinitions="*,4,*" Margin="12">
            <!-- Sessions List (left) -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Active XMSG Sessions:"
                               FontWeight="SemiBold"
                               Margin="8,8,8,4"/>
                    <ListBox ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession}"
                             Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                             FontFamily="Consolas,Courier New"
                             FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="LCN="/><Run Text="{Binding LCN, StringFormat='{}{0:D3}'}"/>
                                    <Run Text=" Port="/><Run Text="{Binding Port, StringFormat='{}{0:X4}'}"/>
                                    <Run Text=" "/><Run Text="{Binding ServiceName}"/>
                                    <Run Text=" "/><Run Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                          Width="4"/>

            <!-- Session Details (right) -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Session Details:"
                               FontWeight="SemiBold"
                               Margin="8,8,8,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                                  Padding="8">
                        <TextBlock Text="{Binding SessionDetails}"
                                   FontFamily="Consolas,Courier New"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>

</Window>
