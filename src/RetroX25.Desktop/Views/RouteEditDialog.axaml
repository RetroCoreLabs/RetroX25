<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroX25.Desktop.ViewModels"
        x:Class="RetroX25.Desktop.Views.RouteEditDialog"
        x:DataType="vm:RouteEditDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="560" Height="720"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico">

    <Grid RowDefinitions="*,Auto" Margin="16">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- What do you want to reach? -->
                <StackPanel Spacing="4">
                    <TextBlock Text="What do you want to reach?" FontSize="15" FontWeight="SemiBold"/>
                    <ComboBox Name="KindBox" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteKindChoice">
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding KindHelp}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- The digits -->
                <StackPanel Spacing="4" IsVisible="{Binding HasMatch}">
                    <TextBlock Text="{Binding MatchLabel}" FontWeight="SemiBold"/>
                    <TextBox Name="MatchBox" Text="{Binding Match}" Watermark="{Binding MatchWatermark}"/>
                    <TextBlock Text="{Binding MatchCountry}" FontSize="11"
                               IsVisible="{Binding MatchCountry, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- Name -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Name" FontWeight="SemiBold"/>
                    <TextBox Name="NameBox" Text="{Binding Name}" Watermark="for example Sweden, Gateway, Terminals"/>
                </StackPanel>

                <!-- Where calls go -->
                <StackPanel Spacing="4" IsVisible="{Binding HasPort}">
                    <TextBlock Text="Send the calls to" FontWeight="SemiBold"/>
                    <ComboBox Name="PortBox" ItemsSource="{Binding PortNames}" SelectedItem="{Binding Port}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="A line of this node, or 'local' for a service on this node (the TAD, a waiting program)."/>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding IsHunt}">
                    <TextBlock Text="Lines of the hunt group" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding HuntPortsText}" Watermark="line names separated by commas"/>
                </StackPanel>

                <!-- Backups, in order -->
                <StackPanel Spacing="4" IsVisible="{Binding HasPort}">
                    <TextBlock Text="Backup ports, tried in this order when the port is out of order" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,8,Auto">
                        <ListBox Grid.Column="0" ItemsSource="{Binding BackupPorts}" SelectedItem="{Binding SelectedBackup}"
                                 MinHeight="60" MaxHeight="120"/>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <Button Content="Up" Command="{Binding MoveBackupUpCommand}" HorizontalAlignment="Stretch"/>
                            <Button Content="Down" Command="{Binding MoveBackupDownCommand}" HorizontalAlignment="Stretch"/>
                            <Button Content="Remove" Command="{Binding RemoveBackupCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,8,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding PortNames}" SelectedItem="{Binding BackupToAdd}"
                                  HorizontalAlignment="Stretch" PlaceholderText="a port to add as the next backup"/>
                        <Button Grid.Column="2" Content="Add backup" Command="{Binding AddBackupCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding BackupOrderText}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <CheckBox Content="Route is on" IsChecked="{Binding Enabled}"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Note (optional)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>
                </StackPanel>

                <!-- Live check -->
                <Border Background="#22F44336" BorderBrush="#F44336" BorderThickness="1" CornerRadius="4" Padding="8"
                        IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Name="ErrorText" Text="{Binding ValidationError}" TextWrapping="Wrap"/>
                </Border>

                <!-- Preview -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Preview: where would this number go?" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding PreviewNumber}"/>
                        <TextBlock Name="PreviewText" Text="{Binding PreviewText}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Command="{Binding OkCommand}" Content="OK" Width="80" IsDefault="True" Classes="accent"
                    IsEnabled="{Binding IsValid}" Click="OnOkClick"/>
            <Button Command="{Binding CancelCommand}" Content="Cancel" Width="80" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>

    </Grid>
</Window>
