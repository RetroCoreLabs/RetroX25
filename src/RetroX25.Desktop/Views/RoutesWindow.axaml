<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroX25.Desktop.ViewModels"
        xmlns:views="using:RetroX25.Desktop.Views"
        x:Class="RetroX25.Desktop.Views.RoutesWindow"
        x:DataType="vm:RoutingViewModel"
        Icon="/Assets/icon.ico"
        Title="Routing"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600">

    <!-- DataGrid StyleInclude (the grid is inside the routing view, which includes it as well) -->
    <Window.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Window.Styles>

    <!-- The same screen as the Routing tab of the Configuration window. -->
    <views:RoutingView/>

</Window>
