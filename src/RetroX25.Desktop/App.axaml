<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RetroX25.Desktop.App"
             xmlns:local="using:RetroX25.Desktop"
             xmlns:converters="using:RetroX25.Desktop.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Global Value Converters -->
        <converters:ByteArrayToHexConverter x:Key="ByteArrayToHexConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:IntEqualsConverter x:Key="IntEqualsConverter"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>