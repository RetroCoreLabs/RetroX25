<Project>
  <!-- Central package versions. Generated by rename.py from the highest version seen per package; edit by hand afterwards. -->
  <PropertyGroup>
    <!-- The app repos reference RetroIO as 0.1.0-local.* so a fresh publish-local stamp is always
         picked up. Central Package Management REJECTS a floating PackageVersion unless this is on
         (NU1011), so the local-feed workflow does not build without it. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="MessageBox.Avalonia" Version="3.1.6" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="NodifyM.Avalonia" Version="1.1.9" />
    <PackageVersion Include="NUnit" Version="4.0.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.0.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="Terminal.Gui" Version="1.19.0" />
    <PackageVersion Include="xunit" Version="2.6.6" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageVersion Include="RetroIO.Protocols.X25" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Client" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Monitor" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Nmc" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Routing" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Runtime" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Switch" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.X25.Switch.Management" Version="0.1.0-local.*" />
  </ItemGroup>
</Project>
